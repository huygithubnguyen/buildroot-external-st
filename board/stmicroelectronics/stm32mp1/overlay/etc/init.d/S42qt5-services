#!/bin/sh
### BEGIN INIT INFO
# Provides:          qt5-services
# Required-Start:     $local_fs $syslog qt5-env display touch
# Required-Stop:      $local_fs $syslog
# Default-Start:      2 3 4 5
# Default-Stop:       0 1 6
# Short-Description:  Qt5 application services for STM32MP157F-DK2
# Description:        Start Qt5 applications and service manager
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# Start Qt5 application services
start_qt5_services() {
    echo "Starting Qt5 services..."
    
    # Create Qt5 runtime directories

    # Setup IPC mechanisms
    if [ -x "/usr/bin/qt5-ipc-setup" ]; then
        echo "Setting up Qt5 IPC..."
        /usr/bin/qt5-ipc-setup
    fi
    mkdir -p /var/run/qt5
    mkdir -p /var/log/qt5
    mkdir -p /var/cache/qt5
    
    # Set proper permissions
    chmod 755 /var/run/qt5
    chmod 755 /var/log/qt5
    chmod 755 /var/cache/qt5
    
    # Start Qt5 application manager if available
    if [ -x "/usr/bin/qt5-app-manager" ]; then
        echo "Starting Qt5 application manager..."
        /usr/bin/qt5-app-manager &
    fi
    
    # Start Qt5 demo application if available
    if [ -x "/usr/bin/qt5-demo" ]; then
        echo "Starting Qt5 demo application..."
        /usr/bin/qt5-demo &
    fi
    
    # Start bike computer application if available
    if [ -x "/usr/bin/bikecomputer" ]; then
        echo "Starting bike computer application..."
        /usr/bin/bikecomputer &
    fi
    
    echo "Qt5 services started"
}

# Configure Qt5 service environment
configure_qt5_services() {
    echo "Configuring Qt5 services environment..."
    
    # Set Qt5 service environment variables
    export QT_QPA_PLATFORM=eglfs
    export QT_QPA_EGLFS_KMS_CONFIG=/etc/qt5/kms-config.json
    export QT_LOGGING_RULES="qt.qpa.*=false"
    
    # Create Qt5 service configuration
    if [ ! -d "/etc/qt5" ]; then
        mkdir -p /etc/qt5
    fi
    
    cat > /etc/qt5/services-config.json << CONFEOF
{
    "services": [
        {
            "name": "qt5-demo",
            "executable": "/usr/bin/qt5-demo",
            "autostart": true,
            "restart": true
        },
        {
            "name": "bikecomputer",
            "executable": "/usr/bin/bikecomputer",
            "autostart": false,
            "restart": true
        }
    ]
}
CONFEOF
    
    echo "Qt5 services environment configured"
}

# Validate Qt5 services setup
validate_qt5_services() {
    echo "Validating Qt5 services setup..."
    
    # Check Qt5 libraries
    if [ ! -d "/usr/lib/qt5" ]; then
        echo "Warning: Qt5 libraries not found"
    fi
    
    # Check Qt5 configuration
    if [ ! -f "/etc/qt5/kms-config.json" ]; then
        echo "Warning: KMS configuration not found"
    fi
    
    # Check service configuration
    if [ ! -f "/etc/qt5/services-config.json" ]; then
        echo "Warning: Service configuration not found"
    fi
    
    echo "Qt5 services validation complete"
    return 0
}

# Main function
start() {
    echo "Starting Qt5 services..."
    
    # Configure Qt5 services environment
    configure_qt5_services
    
    # Start Qt5 services
    start_qt5_services
    
    # Validate setup
    validate_qt5_services
    
    echo "Qt5 services startup completed"
}

# Stop function
stop() {
    echo "Stopping Qt5 services..."
    
    # Kill Qt5 applications
    killall qt5-demo 2>/dev/null
    killall bikecomputer 2>/dev/null
    killall qt5-app-manager 2>/dev/null
    
    # Cleanup runtime files
    rm -rf /var/run/qt5/*
    
    echo "Qt5 services stopped"
}

# Restart function
restart() {
    stop
    sleep 2
    start
}

# Status function
status() {
    echo "=== STM32MP157F-DK2 Qt5 Services Status ==="
    
    echo "Running Qt5 applications:"
    ps aux | grep -E "(qt5-demo|bikecomputer|qt5-app-manager)" | grep -v grep | sed 's/^/  /' || echo "  No Qt5 applications running"
    
    echo ""
    echo "Configuration files:"
    if [ -f "/etc/qt5/services-config.json" ]; then
        echo "  ✅ /etc/qt5/services-config.json - EXISTS"
    else
        echo "  ❌ /etc/qt5/services-config.json - MISSING"
    fi
    
    if [ -f "/etc/qt5/kms-config.json" ]; then
        echo "  ✅ /etc/qt5/kms-config.json - EXISTS"
    else
        echo "  ❌ /etc/qt5/kms-config.json - MISSING"
    fi
    
    echo ""
    echo "Runtime directories:"
    if [ -d "/var/run/qt5" ]; then
        echo "  ✅ /var/run/qt5 - EXISTS"
        ls -la /var/run/qt5/ 2>/dev/null | sed 's/^/    /'
    else
        echo "  ❌ /var/run/qt5 - MISSING"
    fi
    
    echo "=== Status Complete ==="
}

# Handle command line arguments
case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        echo "  start   - Start Qt5 services"
        echo "  stop    - Stop Qt5 services"
        echo "  restart - Restart Qt5 services"
        echo "  status  - Show Qt5 services status"
        exit 1
        ;;
esac

exit 0
