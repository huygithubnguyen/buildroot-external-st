#!/bin/sh
### BEGIN INIT INFO
# Provides:          touch
# Required-Start:     $local_fs $syslog display
# Required-Stop:      $local_fs $syslog
# Default-Start:      2 3 4 5
# Default-Stop:       0 1 6
# Short-Description:  Touch screen setup for STM32MP157F-DK2
# Description:        Configure touch screen and tslib for Qt5 applications
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# Detect touch screen device
detect_touch_device() {
    echo "Detecting touch screen device..."
    
    # Look for touch screen input devices
    for device in /dev/input/event*; do
        if [ -e "$device" ]; then
            # Check if device is a touch screen
            if udevadm info --query=property --name="$device" | grep -q "ID_INPUT_TOUCHSCREEN=1"; then
                TOUCH_DEVICE="$device"
                echo "Touch screen found: $TOUCH_DEVICE"
                return 0
            fi
        fi
    done
    
    # Fallback: try event0
    if [ -e "/dev/input/event0" ]; then
        TOUCH_DEVICE="/dev/input/event0"
        echo "Using fallback touch device: $TOUCH_DEVICE"
        return 0
    fi
    
    echo "Error: No touch screen device found"
    return 1
}

# Initialize touch screen
init_touchscreen() {
    echo "Initializing touch screen..."
    
    # Load input modules
    modprobe evdev 2>/dev/null
    modprobe input_core 2>/dev/null
    
    # Detect touch device
    if ! detect_touch_device; then
        echo "Touch screen detection failed"
        return 1
    fi
    
    # Set touch device permissions
    chmod 666 "$TOUCH_DEVICE"
    chgrp input "$TOUCH_DEVICE"
    
    # Create tslib calibration file if it does not exist
    if [ ! -f "/etc/pointercal" ]; then
        echo "Creating default tslib calibration file..."
        cat > /etc/pointercal << CALIBEOF
-59 20688 -536 4294936768 532 -20688 4294967296 65536
CALIBEOF
        chmod 644 /etc/pointercal
    fi
    
    echo "Touch screen initialized"
}

# Configure Qt5 touch input
configure_qt5_touch() {
    echo "Configuring Qt5 touch input..."
    
    # Update Qt5 environment with detected touch device
    export QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS="$TOUCH_DEVICE"
    
    echo "Qt5 touch input configured"
}

# Validate touch screen setup
validate_touchscreen() {
    echo "Validating touch screen setup..."
    
    # Check touch device
    if [ ! -e "$TOUCH_DEVICE" ]; then
        echo "Error: Touch device not available"
        return 1
    fi
    
    # Check tslib configuration
    if [ ! -f "/etc/ts.conf" ]; then
        echo "Warning: tslib configuration not found - creating default"
        cat > /etc/ts.conf << CONFEOF
# tslib configuration for STM32MP157F-DK2
module_raw input
module linear
CONFEOF
        chmod 644 /etc/ts.conf
    fi
    
    echo "Touch screen validation complete"
    return 0
}

# Main function
start() {
    echo "Starting touch screen setup..."
    
    # Initialize touch screen
    if ! init_touchscreen; then
        echo "Touch screen initialization failed"
        return 1
    fi
    
    # Configure Qt5 touch input
    configure_qt5_touch
    
    # Validate touch screen setup
    if ! validate_touchscreen; then
        echo "Touch screen validation failed"
        return 1
    fi
    
    echo "Touch screen setup completed successfully"
}

# Stop function
stop() {
    echo "Stopping touch screen..."
    echo "Touch screen stopped"
}

# Restart function
restart() {
    stop
    sleep 1
    start
}

# Status function
status() {
    echo "=== STM32MP157F-DK2 Touch Screen Status ==="
    
    if [ -n "$TOUCH_DEVICE" ] && [ -e "$TOUCH_DEVICE" ]; then
        echo "✅ Touch device: $TOUCH_DEVICE - AVAILABLE"
        ls -la "$TOUCH_DEVICE" | sed 's/^/  /'
    else
        echo "❌ Touch device: NOT DETECTED"
        echo "Available input devices:"
        ls -la /dev/input/event* 2>/dev/null | sed 's/^/  /' || echo "  No input devices found"
    fi
    
    echo ""
    echo "Configuration files:"
    if [ -f "/etc/pointercal" ]; then
        echo "  ✅ /etc/pointercal - EXISTS"
    else
        echo "  ❌ /etc/pointercal - MISSING"
    fi
    
    if [ -f "/etc/ts.conf" ]; then
        echo "  ✅ /etc/ts.conf - EXISTS"
    else
        echo "  ❌ /etc/ts.conf - MISSING"
    fi
    
    echo "=== Status Complete ==="
}

# Handle command line arguments
case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        echo "  start   - Initialize touch screen"
        echo "  stop    - Stop touch screen"
        echo "  restart - Restart touch screen"
        echo "  status  - Show touch screen status"
        exit 1
        ;;
esac

exit 0
