#!/bin/sh
# Qt5 Environment Setup for STM32MP157F-DK2
# Comprehensive environment configuration for EGLFS backend

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# Validate Qt5 environment setup
validate_qt5_env() {
    echo "Validating Qt5 environment..."
    
    # Check critical environment variables
    [ -n "$QT_QPA_PLATFORM" ] || {
        echo "Error: QT_QPA_PLATFORM not set"
        return 1
    }
    
    # Check KMS configuration file
    [ -f "$QT_QPA_EGLFS_KMS_CONFIG" ] || {
        echo "Error: KMS configuration file not found: $QT_QPA_EGLFS_KMS_CONFIG"
        return 1
    }
    
    # Check Qt5 plugin directory
    [ -d "$QT_PLUGIN_PATH" ] || {
        echo "Error: Qt5 plugin directory not found: $QT_PLUGIN_PATH"
        return 1
    }
    
    # Check QML import directory
    [ -d "$QML2_IMPORT_PATH" ] || {
        echo "Warning: QML import directory not found: $QML2_IMPORT_PATH"
    }
    
    echo "Qt5 environment validation: PASSED"
    return 0
}

# Create Qt5 runtime directories
create_qt5_directories() {
    echo "Creating Qt5 runtime directories..."
    
    # Cache and runtime directories
    mkdir -p /tmp/.qt5cache
    mkdir -p /home/root/.qt5
    mkdir -p /var/cache/qt5
    mkdir -p /var/log/qt5
    mkdir -p /run/qt5
    
    # Set proper permissions
    chmod 755 /var/cache/qt5 /var/log/qt5 /run/qt5
    chmod 755 /home/root/.qt5
    chmod 777 /tmp/.qt5cache
    
    echo "Qt5 runtime directories created"
}

# Set Qt5 environment variables for STM32MP157F-DK2
set_qt5_environment() {
    echo "Setting Qt5 environment variables..."
    
    # Qt5 platform and backend configuration
    export QT_QPA_PLATFORM=eglfs
    export QT_QPA_EGLFS_KMS_CONFIG=/etc/qt5/kms-config.json
    export QT_QPA_EGLFS_INTEGRATION=eglfs_kms
    export QT_QPA_EGLFS_ALWAYS_SET_MODE=1
    
    # Display geometry for STM32MP157F-DK2 (480x272 LCD)
    export QT_QPA_EGLFS_PHYSICAL_WIDTH=480
    export QT_QPA_EGLFS_PHYSICAL_HEIGHT=272
    export QT_QPA_EGLFS_ROTATION=0
    export QT_QPA_EGLFS_WIDTH=480
    export QT_QPA_EGLFS_HEIGHT=272
    
    # Qt5 runtime paths
    export QT_PLUGIN_PATH=/usr/lib/qt5/plugins
    export QML2_IMPORT_PATH=/usr/lib/qt5/qml
    export QT_QPA_FONTDIR=/usr/share/fonts
    
    # Input device configuration
    export QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS=/dev/input/event0
    export QT_QPA_EVDEV_KEYBOARD_PARAMETERS=/dev/input/event1
    export QT_QPA_EVDEV_MOUSE_PARAMETERS=/dev/input/event2
    
    # Touch screen integration
    export TSLIB_CONSOLEDEVICE=none
    export TSLIB_FBDEVICE=/dev/fb0
    export TSLIB_TSDEVICE=/dev/input/event0
    export TSLIB_CALIBFILE=/etc/pointercal
    export TSLIB_CONFFILE=/etc/ts.conf
    export TSLIB_PLUGINDIR=/usr/lib/ts
    
    # Library paths for Qt5
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/lib/qt5/lib
    
    # Performance and debugging settings
    export QT_QPA_EGLFS_DISABLE_BUFFERING=0
    export QT_AUTO_SCREEN_SCALE_FACTOR=1
    
    # Disable debug logging for production (enable for debugging)
    # export QT_LOGGING_RULES=qt.qpa.*=true
    # export QT_DEBUG_PLUGINS=1
    
    echo "Qt5 environment variables set"
}

# Detect and configure touch device dynamically
detect_touch_device() {
    echo "Detecting touch device..."
    
    # Look for touch screen input devices
    for device in /dev/input/event*; do
        if [ -e "$device" ]; then
            # Check if device is a touch screen using udev
            if udevadm info --query=property --name="$device" 2>/dev/null | grep -q "ID_INPUT_TOUCHSCREEN=1"; then
                export QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS="$device"
                export TSLIB_TSDEVICE="$device"
                echo "Touch device detected: $device"
                return 0
            fi
        fi
    done
    
    # Fallback to event0 if no touch device found
    if [ -e "/dev/input/event0" ]; then
        export QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS="/dev/input/event0"
        export TSLIB_TSDEVICE="/dev/input/event0"
        echo "Using fallback touch device: /dev/input/event0"
        return 0
    fi
    
    echo "Warning: No touch device found"
    return 1
}

# Validate display device availability
validate_display_device() {
    echo "Validating display device..."
    
    # Check DRM device
    if [ ! -e "/dev/dri/card0" ]; then
        echo "Error: DRM display device not found: /dev/dri/card0"
        return 1
    fi
    
    # Check KMS configuration
    if [ ! -f "/etc/qt5/kms-config.json" ]; then
        echo "Error: KMS configuration not found: /etc/qt5/kms-config.json"
        return 1
    fi
    
    # Check framebuffer device as fallback
    if [ ! -e "/dev/fb0" ]; then
        echo "Warning: Framebuffer device not found: /dev/fb0"
    fi
    
    echo "Display device validation: PASSED"
    return 0
}

# Main start function
start_qt5_env() {
    echo "Starting Qt5 environment setup..."
    
    # Validate display device first
    if ! validate_display_device; then
        echo "Error: Display validation failed"
        return 1
    fi
    
    # Detect touch device
    detect_touch_device
    
    # Set Qt5 environment variables
    set_qt5_environment
    
    # Create runtime directories
    create_qt5_directories
    
    # Validate environment setup
    if ! validate_qt5_env; then
        echo "Error: Qt5 environment validation failed"
        return 1
    fi
    
    echo "Qt5 environment setup completed successfully"
    return 0
}

# Stop function
stop_qt5_env() {
    echo "Stopping Qt5 environment..."
    
    # Cleanup runtime files (optional)
    # rm -rf /tmp/.qt5cache/*
    # rm -rf /var/cache/qt5/*
    
    # Unset Qt5 environment variables
    unset QT_QPA_PLATFORM QT_QPA_EGLFS_KMS_CONFIG QT_QPA_EGLFS_INTEGRATION
    unset QT_QPA_EGLFS_PHYSICAL_WIDTH QT_QPA_EGLFS_PHYSICAL_HEIGHT QT_QPA_EGLFS_ROTATION
    unset QT_QPA_EGLFS_WIDTH QT_QPA_EGLFS_HEIGHT QT_QPA_EGLFS_ALWAYS_SET_MODE
    unset QT_PLUGIN_PATH QML2_IMPORT_PATH QT_QPA_FONTDIR
    unset QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS QT_QPA_EVDEV_KEYBOARD_PARAMETERS QT_QPA_EVDEV_MOUSE_PARAMETERS
    unset TSLIB_CONSOLEDEVICE TSLIB_FBDEVICE TSLIB_TSDEVICE TSLIB_CALIBFILE TSLIB_CONFFILE TSLIB_PLUGINDIR
    unset QT_QPA_EGLFS_DISABLE_BUFFERING QT_AUTO_SCREEN_SCALE_FACTOR
    
    echo "Qt5 environment stopped"
}

# Main script logic
case "$1" in
    start)
        start_qt5_env
        ;;
    stop)
        stop_qt5_env
        ;;
    restart|reload)
        echo "Restarting Qt5 environment..."
        $0 stop
        sleep 2
        $0 start
        ;;
    status)
        if [ -n "$QT_QPA_PLATFORM" ] && [ -f "$QT_QPA_EGLFS_KMS_CONFIG" ]; then
            echo "Qt5 environment is active"
            echo "Platform: $QT_QPA_PLATFORM"
            echo "KMS Config: $QT_QPA_EGLFS_KMS_CONFIG"
            echo "Touch Device: $QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS"
        else
            echo "Qt5 environment is not active"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        echo "  start   - Initialize Qt5 environment for STM32MP157F-DK2"
        echo "  stop    - Cleanup Qt5 environment"
        echo "  restart - Restart Qt5 environment"
        echo "  status  - Show Qt5 environment status"
        exit 1
        ;;
esac

exit $?
