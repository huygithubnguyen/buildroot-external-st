config BR2_PACKAGE_QT_DEMO_SIMPLE
	bool "qt-demo-simple"
	depends on BR2_PACKAGE_QT5
	depends on BR2_PACKAGE_JSON_C
	depends on BR2_PACKAGE_QT5_IPC_SYSTEM
	select BR2_PACKAGE_QT5BASE_WIDGETS
	help
	  Qt5 Demo Simple application for STM32MP157F-DK2
	  Demonstrates Qt5 + IPC integration with comprehensive testing
	  including touch events, display updates, status messages,
	  and JSON parsing capabilities. Requires qt5-ipc-system package.
	  
	  Features:
	  - Console-based Qt5 application
	  - IPC client integration with qt5-ipc-system
	  - Touch coordinate testing
	  - Display parameter updates
	  - Service status monitoring
	  - JSON message parsing and validation
	  - Performance metrics and queue monitoring
	  
	  This package provides a working example of Qt5 application
	  development for embedded Linux systems with IPC communication.
	  Requires the IPC daemon service from qt5-ipc-system package.

comment "qt-demo-simple needs Qt5, json-c, and qt5-ipc-system"
	depends on !BR2_PACKAGE_QT5 || !BR2_PACKAGE_JSON_C || !BR2_PACKAGE_QT5_IPC_SYSTEM