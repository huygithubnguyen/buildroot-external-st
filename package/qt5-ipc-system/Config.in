config BR2_PACKAGE_QT5_IPC_SYSTEM
	bool "qt5-ipc-system"
	depends on BR2_USE_MMU
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_QT5BASE
	select BR2_PACKAGE_QT5BASE_WIDGETS
	select BR2_PACKAGE_QT5DECLARATIVE
	help
	  Qt5 IPC System provides inter-process communication for embedded
	  applications on STM32MP157F-DK2. Includes:
	  - Core IPC library (C)
	  - Qt5 wrapper library (C++)
	  - IPC daemon for service management
	  - JSON-based message protocol
	  - Socket-based communication

	  This package is required by qt-bike-gui and other Qt5 applications
	  that need IPC communication on the STM32MP157F-DK2 platform.

if BR2_PACKAGE_QT5_IPC_SYSTEM

config BR2_PACKAGE_QT5_IPC_SYSTEM_DEBUG
	bool "Enable debug build"
	help
	  Enable debug symbols and logging for qt5-ipc-system.
	  Useful for development and troubleshooting.

endif

comment "qt5-ipc-system needs toolchain with MMU, C++ and threads"
	depends on !BR2_USE_MMU || !BR2_INSTALL_LIBSTDCPP || \
		!BR2_TOOLCHAIN_HAS_THREADS
